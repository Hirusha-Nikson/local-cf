{
  "name": "@local-cf/site",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Public site: marketing + docs + hosted dashboard, deployed to Cloudflare Workers via OpenNext.",
  "license": "MIT",
  "author": "H Nikson <hirushanikson@gmail.com> (https://github.com/Hirusha-Nikson)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hirusha-Nikson/local-cf.git",
    "directory": "apps/site"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:deploy:production": "opennextjs-cloudflare deploy --env production"
  },
  "dependencies": {
    "@local-cf/ui": "workspace:*",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.5.22",
    "@opennextjs/cloudflare": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
